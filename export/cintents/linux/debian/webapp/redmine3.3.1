<a href="./" class="home">Home</a> &gt; <a href="./cintents/linux/">linux</a> &gt; <a href="./cintents/linux/debian/">Debian Gnu/Linux</a> &gt; <a href="./cintents/linux/debian/webapp/">webapp</a> &gt; redmine3.3.1
      <h1>- debian_jessie + postgresql + redmine -</h1>
	<p>easy gantt onedmine 3.3,1</p>
	<p>debian_jessie + postgresql + redmine<br /><br />&nbsp;&nbsp;&nbsp; postgresql9.4&nbsp;&nbsp; - debian native<br />&nbsp; redmine 3.3.31&nbsp;&nbsp;&nbsp; - redmine.org よりダウンロード<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; http://www.redmine.org/releases/redmine-3.3.1.tar.gz<br /><br />パッケージをインストール<br /><br />&nbsp; # 必要なパッケージをインストール<br />&nbsp;&nbsp;&nbsp; $ sudo apt-get install apache2-dev apache2-mpm-prefork build-<br />&nbsp;&nbsp;&nbsp; essential&nbsp; checkinstall fonts-takao imagemagick libapache2-mod-<br />&nbsp;&nbsp;&nbsp; passenger libapr1-dev libcurl4-openssl-dev libgmp-dev liblzma-dev <br />&nbsp;&nbsp;&nbsp; libmagick++-dev libmagickwand-dev libssl-dev libxml2-dev libxslt1-<br />&nbsp;&nbsp;&nbsp; dev libyaml-dev patch ruby ruby-dev ruby-zip zlib1g-dev zlibc<br /><br />&nbsp; #database server<br />&nbsp;&nbsp;&nbsp; # postgresql server setup<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; $ sudo apt-get install postgresql libpq-dev<br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; $ sudo -u postgres psql<br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; postgres=# CREATE ROLE redmine LOGIN ENCRYPTED PASSWORD <br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 'zxcvbnm31419806' NOINHERIT VALID UNTIL 'infinity';<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; postgres=# CREATE DATABASE redmine WITH ENCODING='UTF8' OWNER<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; =redmine;<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; postgres=# \q<br /><br />redmine をダウンロード<br /><br />&nbsp;&nbsp;&nbsp; $ wget http://www.redmine.org/releases/redmine-3.3.1.tar.gz<br />&nbsp;&nbsp;&nbsp; $ tar zxvf redmine-3.3.1.tar.gz<br />&nbsp;&nbsp;&nbsp; $ cd redmine-3.3.1<br /><br /><br /><br />&nbsp;&nbsp;&nbsp; $ sudo mv config/database.yml.example config/database.yml<br />&nbsp;&nbsp;&nbsp; $ sudo nano config/database.yml<br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; database に合せて設定を記述<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; # PostgreSQL configuration example<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; production:<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; adapter: postgresql<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; database: redmine<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; host: localhost<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; username: redmine<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; password: "tfctycuvuyt<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; encoding: utf8<br /><br /><br />&nbsp;&nbsp;&nbsp; # redmineデータをバックアップするためのパッケージを追加<br />&nbsp;&nbsp;&nbsp; $ nano Gemfile<br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; gem "yaml_db"<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; の1行を適当な行に追記<br /><br />&nbsp;&nbsp;&nbsp; $ sudo gem install bundler<br />&nbsp;&nbsp;&nbsp; $ bundle install --without development test<br /><br />&nbsp;&nbsp;&nbsp; $ bundle exec rake generate_secret_token</p>
<p>&nbsp;&nbsp;&nbsp;&nbsp; #secret_token.rb の存在確認<br />&nbsp;&nbsp;&nbsp; $ ls -la config/initializers/secret_token.rb</p>
<pre><br />  # Redmine用ユーザーの作成<br />  $ sudo -u postgres createuser -P redmine<br /><br />  #Redmine用データベースの作成 <br />  $ sudo -u postgres createdb -E UTF-8 -l ja_JP.UTF-8 -O redmine -T template0 redmine</pre>
<p>&nbsp;&nbsp;&nbsp; # テーブル作成<br />&nbsp;&nbsp;&nbsp; $ RAILS_ENV=production bundle exec rake db:migrate<br />&nbsp;&nbsp;&nbsp; # デフォルトデータ投入<br />&nbsp;&nbsp;&nbsp; $ RAILS_ENV=production bundle exec rake redmine:load_default_data<br /><br /><br />&nbsp;&nbsp;&nbsp; $ mkdir -p tmp tmp/pdf public/plugin_assets<br />&nbsp;&nbsp;&nbsp; $ chmod -R 755 files log tmp public/plugin_assets<br /><br /># easy gantt install<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; $ wget http://www.easyredmine.com/packages/EasyGanttFree.zip<br />&nbsp;&nbsp;&nbsp; $ unzip EasyGanttFree.zip<br />&nbsp;&nbsp;&nbsp; $ cp -a easygantt plugins/<br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; $ bundle install<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (or bundle update)<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; $ bundle exec rake db:migrate RAILS_ENV=production<br />&nbsp;&nbsp;&nbsp; $ bundle exec rake redmine:plugins:migrate RAILS_ENV=production<br /><br /><br /><br />&nbsp;&nbsp;&nbsp; $ cd ../<br />&nbsp;&nbsp;&nbsp; $ sudo cp -av redmine-3.3.1 /srv/<br /><br />&nbsp;&nbsp;&nbsp; $ cd /srv/<br />&nbsp;&nbsp;&nbsp; $ sudo chown -R www-data:www-data ./redmine-3.3.1<br />&nbsp;&nbsp;&nbsp; $ sudo chown -R www-data:www-data files log tmp public/plugin_assets<br /><br /># passengerセットアップ<br /><br />&nbsp;&nbsp;&nbsp; $ sudo gem install passenger --no-rdoc --no-ri<br />&nbsp;&nbsp;&nbsp; $ sudo passenger-install-apache2-module<br /><br />&nbsp;&nbsp;&nbsp; 変更の確認<br />&nbsp;&nbsp;&nbsp; $ sudo passenger-install-apache2-module --snippet<br /><br />&nbsp;&nbsp;&nbsp; $ sudo nano /etc/apache2/mods-available/passenger.conf<br />&nbsp;&nbsp; &nbsp;<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &lt;IfModule mod_passenger.c<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; PassengerRoot /var/lib/gems/2.1.0/gems/passenger-5.0.30<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; PassengerDefaultRuby /usr/bin/ruby2.1<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &lt;/IfModule&gt;<br /><br />&nbsp;&nbsp;&nbsp; $ sudo nano /etc/apache2/mods-available/passenger.load<br /><br />&nbsp;&nbsp; LoadModule passenger_module /var/lib/gems/2.1.0/gems/passenger-5.0.30<br />&nbsp;&nbsp; /buildout/apache2/mod_passenger.so<br /><br /><br />&nbsp;&nbsp;&nbsp; $ sudo cp -r ~/work/redmine-3.3.1 /srv/<br /><br />&nbsp;&nbsp;&nbsp; $ cd /srv/<br />&nbsp;&nbsp;&nbsp; $ sudo chown -R www-data:www-data ./redmine-3.3.1<br /><br />&nbsp;&nbsp;&nbsp; $ sudo nano /etc/apache2/sites-available/000-default.conf<br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ServerAdmin webmaster@localhost<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; DocumentRoot /var/www/html<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; RackBaseURI /products/redmine&nbsp;&nbsp;&nbsp; &larr; 追記<br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; $ sudo mkdir /var/www/html/products<br />&nbsp;&nbsp;&nbsp; $ sudo ln -s /srv/redmine-3.3.1/public /var/www/html/products/<br />&nbsp;&nbsp;&nbsp; redmine<br />&nbsp;&nbsp;&nbsp; $ sudo apache2ctl configtest<br /><br />&nbsp;&nbsp;&nbsp; $ sudo /etc/init.d/apache2 restart<br /><br />&nbsp;&nbsp;&nbsp; http://server-ip/products/redmine<br />&nbsp;&nbsp; &nbsp;<br /><br /><br /></p>
